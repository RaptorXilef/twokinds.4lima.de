.env
.env.local
.env.*.local
!/.env.example
config/secrets/*
/config/secrets.php
/config/_dev.local.php
*.local*

# ==============================================================================
# 4. BACKEND (PHP & COMPOSER)
# ==============================================================================
/vendor/
/composer.phar
!composer.lock

# Cache & Logs
/.cache/
.cache/php-cs-fixer/cache.json
/.phpstan.cache/
.phpcs.cache

# Testing & CI
.phpunit.result.cache
/.phpunit.cache/
/phpunit.xml
.lighthouseci/
.deptrac.cache
/coverage/*
/html-coverage/*

# Datenbank Dumps
*.sql
*.sqlite
*.sqlite3

# ==============================================================================
# 5. FRONTEND (NODE & BUILDS)
# ==============================================================================
/node_modules/
!package-lock.json
npm-debug.log*
yarn-error.log
yarn.lock

# Build Ordner & Tools
/build/
/.build/
/tools/*.phar
.debug/*

# ==============================================================================
# 6. PROJEKTSPEZIFISCH: DATEN & GENERIERTES
# ==============================================================================
# CSpell Wörterbücher (Erlaubt)
!cspell-project.txt
!cspell-general.txt
!cspell-denglisch.txt
!cspell-proper-names.txt
!cspell-technical.txt
!cspell-folder-names.txt

# Veraltete / Zu löschende Dateien
*_deprecated*
*_remove*
*_DEPRECATED*
*_REMOVE*

# Projekt-Dateien
rss.xml
sitemap.xml
public/migration_data/*
public/google*.html
!.gitkeep

# ==============================================================================
# 7. PROJEKTSPEZIFISCH: ASSETS & BILDER
# ==============================================================================
# Development Notes
!public/dev/.php

# Quell-Bilder (src) ignorieren
src/assets/images/

# Quell-Design
src/assets/scss/*.css
src/assets/scss/*.map

# ------------------------------------------------------------------------------
# PUBLIC ASSETS RULESET
# Wir ignorieren zuerst alles in public/assets und öffnen dann gezielt!
# ------------------------------------------------------------------------------
public/assets/*

# CSS & JS erlauben (aber nur die .gitkeeps, wenn generiert!)
!public/assets/css/
public/assets/css/*
!public/assets/css/.gitkeep

!public/assets/js/
public/assets/js/*
!public/assets/js/.gitkeep

# Fonts komplett erlauben
!public/assets/fonts/

# --- IMAGES ---
!public/assets/images/

# Admin Bilder

# Characters (komplexe Ausnahmen)
!public/assets/images/characters/
!public/assets/images/characters/avatars/
public/assets/images/characters/avatars/*
!public/assets/images/characters/avatars/*.gif
!public/assets/images/characters/palettes/
public/assets/images/characters/palettes/*
!public/assets/images/characters/palettes/*.gif
!public/assets/images/characters/portraits/
public/assets/images/characters/portraits/*
!public/assets/images/characters/portraits/*.webp
!public/assets/images/characters/profiles/
public/assets/images/characters/profiles/*
!public/assets/images/characters/profiles/*.webp

# (TODO: Wenn übersetzt auf GitHub synchronisieren)
public/assets/images/characters/refsheets/

# Comic-Bilder komplett ignorieren
public/assets/images/comics/

# Reports
!public/assets/images/reports/
public/assets/images/reports/*
!public/assets/images/reports/.gitkeep

# System
!public/assets/images/system/
public/assets/images/system/*
!public/assets/images/system/*.webp

# Theme (nur webp erlauben)
!public/assets/images/theme/
public/assets/images/theme/*
!public/assets/images/theme/*.webp

!public/assets/images/theme/banners/
public/assets/images/theme/banners/*
!public/assets/images/theme/banners/*.webp

!public/assets/images/theme/footer-chars/
public/assets/images/theme/footer-chars/*
!public/assets/images/theme/footer-chars/*.webp

