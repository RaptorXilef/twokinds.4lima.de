<?php

declare(strict_types=1);

use App\Contracts\Config\ConfigInterface;

/**
 * @var string $baseUrl
 * @var ConfigInterface $config
 * @var array $mailQueue
 * @var array $mailLogs
 */
$groupedQueue = [];
$queueTemplates = [];
foreach ($mailQueue as $mail) {
    $minute = \substr($mail['created_at'], 0, 16);
    $key = $minute . '|' . $mail['template'] . '|' . $mail['subject'];
    if (!isset($groupedQueue[$key])) {
        $groupedQueue[$key] = ['ids' => [], 'recipients' => [], 'created_at' => $mail['created_at'], 'subject' => $mail['subject'], 'template' => $mail['template'], 'priority' => $mail['priority'], 'attempts' => $mail['attempts']];
    }
    $groupedQueue[$key]['ids'][] = $mail['id'];
    $groupedQueue[$key]['recipients'][] = $mail['recipient'];
    $queueTemplates[$mail['template']] = true;
}
foreach ($groupedQueue as &$g) {
    \natcasesort($g['recipients']);
    $g['recipients'] = \array_values($g['recipients']);
}
unset($g);
\ksort($queueTemplates);
$groupedLogs = [];
$logTemplates = [];
foreach ($mailLogs as $log) {
    $minute = \substr($log['timestamp'], 0, 16);
    $key = $minute . '|' . $log['template'] . '|' . $log['subject'] . '|' . $log['status'];
    if (!isset($groupedLogs[$key])) {
        $groupedLogs[$key] = ['ids' => [], 'recipients' => [], 'timestamp' => $log['timestamp'], 'subject' => $log['subject'], 'template' => $log['template'], 'status' => $log['status']];
    }
    $groupedLogs[$key]['ids'][] = $log['id'];
    $groupedLogs[$key]['recipients'][] = $log['recipient'];
    $logTemplates[$log['template']] = true;
}
foreach ($groupedLogs as &$g) {
    \natcasesort($g['recipients']);
    $g['recipients'] = \array_values($g['recipients']);
}
unset($g);
\ksort($logTemplates);
?>

