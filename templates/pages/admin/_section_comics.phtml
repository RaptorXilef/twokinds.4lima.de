<!-- ========================================== -->
<!-- SECTION: COMICS                            -->
<!-- ========================================== -->
<section id="section-comics"
         class="content-section active">
    <div class="table-controls actions-bar">
        <div class="top-actions">
            <button type="button"
                    class="button add"
                    id="btn-add-comic">
                <i class="fa-solid fa-plus"></i> Neuen Comic hinzufügen
            </button>
        </div>
    </div>

    <div class="sitemap-table-container">
        <table class="admin-table comic-editor-table">
            <thead>
                <tr>
                    <th>ID / Datum</th>
                    <th>Thumbnail</th>
                    <th>Typ & Kapitel</th>
                    <th>Titel & Transkript</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <?php if (empty($comics)) { ?>
                    <tr>
                        <td colspan="5"
                            class="empty-table-message">Keine Comics gefunden.</td>
                    </tr>
                <?php } else { ?>
                    <?php foreach ($comics as $comic) {
                        $cId       = $comic->id->value;
                        $cb        = $comic->imageUpdatedAt ? '?c=' . $comic->imageUpdatedAt : '';
                        $thumbPath = "{$baseUrl}/assets/images/comic/thumbnails/{$cId}.webp{$cb}";

                        // Alle Daten für JS bereitstellen
                        $charIds   = \array_map(fn ($id) => $id->value, $comic->characterIds);
                        $comicData = \json_encode([
                            'id'          => $cId,
                            'type'        => $comic->type,
                            'name'        => $comic->name,
                            'chapterId'   => $comic->chapterId ?? '',
                            'originalUrl' => $comic->originalUrl,
                            'sketchUrl'   => $comic->sketchUrl,
                            'transcript'  => $comic->transcript ?? '',
                            'characters'  => $charIds,
                        ], \JSON_HEX_APOS | \JSON_HEX_QUOT);
                        ?>
                        <tr>
                            <td class="mono"><?php echo \htmlspecialchars($cId); ?></td>
                            <td>
                                <img src="<?php echo \htmlspecialchars($thumbPath); ?>"
                                     class="comic-thumbnail"
                                     loading="lazy">
                            </td>
                            <td>
                                <span class="comic-type-display"><?php echo \htmlspecialchars($comic->type); ?></span>
                                <?php if ($comic->chapterId) { ?>
                                    <small>Kapitel <?php echo \htmlspecialchars($comic->chapterId); ?></small>
                                <?php } ?>
                            </td>
                            <td>
                                <strong><?php echo \htmlspecialchars($comic->name !== '' ? $comic->name : 'Kein Titel'); ?></strong>
                                <?php if ($comic->transcript) { ?>
                                    <div class="description-preview"><?php echo \strip_tags($comic->transcript); ?></div>
                                <?php } ?>
                            </td>
                            <td class="actions-cell">
                                <form>
                                    <button type="button"
                                            class="button button-orange btn-undo-comic"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            title="Letzte Änderung rückgängig machen">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>
                                    <button type="button"
                                            class="button edit btn-edit-comic"
                                            data-payload='<?php echo $comicData; ?>'
                                            title="Bearbeiten">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button type="button"
                                            class="button delete btn-delete-comic"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            title="Löschen">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <?php } ?>
                <?php } ?>
            </tbody>
        </table>
    </div>
</section>
