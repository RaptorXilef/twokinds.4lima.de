<?php

declare(strict_types=1);

/**
 * @var array  $settings
 * @var string $pageTitle
 * @var bool   $isValidToken
 * @var string $token
 */
$baseUrl = \rtrim($settings['base_url'] ?? '', '/');
include __DIR__ . '/../../layouts/frontend/_public_header.phtml'; ?>
<main>
    <article class="auth-container">
        <header>
            <h1 class="page-header"><?php echo \htmlspecialchars($pageTitle); ?></h1>
        </header>
        <div class="content-box-shadow">
            <?php if (! $isValidToken) { ?>
                <div class="p-20 text-center text-danger border-radius-4"
                     style="background: var(--status-red-bg); border: 1px solid var(--status-red-border);">
                    <i class="fa-solid fa-circle-xmark icon-lg mb-10"></i><br>
                    <strong>Dieser Link ist ungültig oder bereits abgelaufen.</strong><br><br>
                    <a href="<?php echo $baseUrl; ?>/passwort-vergessen" class="button">Neuen Link anfordern</a>
                </div>
            <?php } else { ?>
                <div id="reset-status-msg"
                     class="msg-box"></div>
                <form id="frontend-reset-form"
                      class="admin-form">
                    <input type="hidden"
                           name="token"
                           value="<?php echo \htmlspecialchars($token); ?>">
                    <div class="form-group mb-20">
                        <label>Neues Passwort (min. 8 Zeichen)</label>
                        <input type="password"
                               name="password"
                               required
                               minlength="8">
                    </div>
                    <button type="submit"
