<?php

declare(strict_types=1);

use App\Core\Entity\Character;
use App\Core\Entity\CharacterGroup;

/**
 * @var string           $baseUrl
 * @var Character[]      $characters
 * @var CharacterGroup[] $groups
 * @var array            $assignedIds
 */
?>

<!-- ========================================== -->
<!-- SECTION: GRUPPEN (DRAG & DROP)             -->
<!-- ========================================== -->
<div class="table-controls actions-bar">
    <div class="top-actions">
        <button type="button"
                class="button add"
                id="btn-add-group">
            <i class="fa-solid fa-folder-plus"></i> Neue Gruppe
        </button>
        <button type="button"
                class="button edit"
                id="btn-save-groups">
            <i class="fa-solid fa-save"></i> Sortierung Speichern
        </button>
    </div>
</div>

<div class="d-flex gap-20 align-start">
    <div class="character-group bg-even w-300">
        <div class="character-group-header flex-column align-start cursor-default">
            <h3>Charakter-Pool</h3>
            <button type="button"
                    class="button w-100 mt-5 font-small"
                    id="btn-toggle-pool">Nur Unzugeordnete zeigen
            </button>
        </div>
        <div id="char-pool"
             class="character-list-container sortable-pool p-10 min-h-200">
            <?php foreach ($characters as $char) {
                $pic        = $char->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$char->picUrl}" : 'https://placehold.co/40x40?text=N/A';
                $isAssigned = \in_array($char->id->value, $assignedIds, true); ?>

                <!-- Wichtig: is-assigned Klasse für den Filter -->
                <div class="character-entry <?php echo $isAssigned ? 'is-assigned' : ''; ?>"
                     data-id="<?php echo \htmlspecialchars($char->id->value); ?>">
                    <div class="d-flex align-center gap-10">
                        <img src="<?php echo \htmlspecialchars($pic); ?>">
                        <div class="character-info">
                            <strong><?php echo \htmlspecialchars($char->name); ?></strong>
                        </div>
                    </div>
                    <i class="fa-solid fa-times remove-char-from-group"></i>
                </div>
            <?php } ?>
        </div>
    </div>

    <!-- Die aktiven Gruppen (Dieser Wrapper ist nun selbst sortierbar!) -->
    <div id="groups-wrapper"
         class="flex-1 grid-auto-300">
        <?php foreach ($groups as $group) { ?>
            <div class="character-group">
                <div class="character-group-header d-flex align-center gap-10">
                    <i class="fa-solid fa-grip-vertical group-drag-handle"
                       title="Gruppe verschieben"></i>
                    <div class="flex-1">
                        <h3 contenteditable="true"
                            spellcheck="false"
                            class="group-title-edit mb-0 border-bottom border-dashed outline-none">
                            <?php echo \htmlspecialchars($group->name); ?>
                        </h3>
                        <label class="font-small text-light font-normal mt-5 d-flex align-center gap-5">
                            <input type="checkbox"
                                   class="manual-sort-cb"
                                   <?php echo $group->manualSort ? 'checked' : ''; ?>> Manuell sortieren
                        </label>
                    </div>
                    <button type="button"
                            class="button add btn-add-char-to-group"
                            title="Charaktere hinzufügen"><i class="fa-solid fa-user-plus"></i></button>
                    <button type="button"
                            class="button delete btn-delete-group"
                            title="Gruppe löschen"><i class="fa-solid fa-times"></i></button>
                </div>
                <!-- Wir merken uns den Sort-Status im data-Attribut für JS -->
                <div class="character-list-container sortable-group p-10"
                     data-manual="<?php echo $group->manualSort ? 'true' : 'false'; ?>">
                    <!-- Wenn manuell aus ist, sortieren wir die Liste für die Anzeige alphabetisch -->
                    <?php $renderChars = [];
            foreach ($group->characterIds as $cidObj) {
                foreach ($characters as $c) {
                    if ($c->id->value === $cidObj->value) {
                        $renderChars[] = $c;

                        break;
                    }
                }
            }
            if (! $group->manualSort) {
                \usort($renderChars, fn ($a, $b) => \strcasecmp($a->name, $b->name));
            }
            foreach ($renderChars as $char) {
                $pic = $char->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$char->picUrl}" : 'https://placehold.co/40x40?text=N/A'; ?>
                        <div class="character-entry d-flex justify-between align-center"
                             data-id="<?php echo \htmlspecialchars($char->id->value); ?>">
                            <div class="d-flex align-center gap-10">
                                <img src="<?php echo \htmlspecialchars($pic); ?>">
                                <div class="character-info">
                                    <strong><?php echo \htmlspecialchars($char->name); ?></strong>
                                </div>
                            </div>
                            <i class="fa-solid fa-times remove-char-from-group"
                               title="Aus Gruppe entfernen"></i>
                        </div>
                    <?php } ?>
                </div>
            </div>
        <?php } ?>
    </div>
</div>

