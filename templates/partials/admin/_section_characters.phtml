<?php

declare(strict_types=1);

/**
 * @var string $baseUrl
 * @var array $groups
 * @var array $characters
 * @var array $settings
 * @var array $perms
 */
$allGenders = [];
$allAges = [];
$allSpecies = [];
$allSubspecies = [];
$allLanguages = [];
$allRanks = [];

foreach ($characters as $c) {
    if ($c->gender) {
        $allGenders[$c->gender] = true;
    }
    if ($c->age) {
        $allAges[$c->age] = true;
    }
    if ($c->species) {
        $allSpecies[$c->species] = true;
    }
    if ($c->subspecies) {
        $allSubspecies[$c->subspecies] = true;
    }
    if ($c->languages) {
        foreach (\explode(',', $c->languages) as $l) {
            if (\trim($l) !== '') {
                $allLanguages[\trim($l)] = true;
            }
        }
    }
    if ($c->rank) {
        foreach (\explode(',', $c->rank) as $r) {
            if (\trim($r) !== '') {
                $allRanks[\trim($r)] = true;
            }
        }
    }
}

\ksort($allGenders);
\ksort($allAges);
\ksort($allSpecies);
\ksort($allSubspecies);
\ksort($allLanguages);
\ksort($allRanks);

?>

