                        $thumbPath = "{$baseUrl}/assets/images/comic/thumbnails/{$comicId}.webp{$cb}";

                        $dateObj     = \DateTimeImmutable::createFromFormat('Ymd', \substr($comicId, 0, 8));
                        $displayDate = $dateObj ? $dateObj->format('d.m.Y') : $comicId;
                        $pageName    = "Seite vom {$displayDate}" . ($comic->name !== '' ? ": {$comic->name}" : '');
                        $pageLink    = "{$baseUrl}/comic/{$comicId}";
                        ?>
                        <a href="<?php echo $pageLink; ?>" title="<?php echo \htmlspecialchars($pageName); ?>" class="loaded">
                            <span><?php echo \htmlspecialchars($pageName); ?></span>
                            <!-- Natives Lazy Loading -->
                            <img src="<?php echo \htmlspecialchars($thumbPath); ?>" alt="<?php echo \htmlspecialchars($pageName); ?>" loading="lazy">
