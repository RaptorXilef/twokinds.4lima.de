<section id="section-media" class="content-section">
    <div class="actions-bar" style="margin-bottom: 20px;">
        <button type="button" class="button add" onclick="document.getElementById('media-upload-input').click()">
            <i class="fa-solid fa-upload"></i> Bilder hochladen
        </button>
        <input type="file" id="media-upload-input" accept="image/*" multiple style="display: none;">
    </div>

    <div id="media-gallery" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
        <!-- JS füllt das hier -->
    </div>
</section>
