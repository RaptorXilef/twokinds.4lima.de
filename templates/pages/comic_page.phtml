<?php
declare(strict_types=1);

/**
 * @var \App\Contracts\Config\ConfigInterface $config
 * @var array                                 $settings
 * @var \App\Core\Entity\ComicPage            $comic
 * @var string                                $pageTitle
 * @var array                                 $nav (Wird von der Action geliefert: first, prev, next, last)
 */
$baseUrl = \rtrim($settings['base_url'], '/');
$comicId = $comic->id->value;

// Cache-Buster dynamisch aus der DB (ersetzt die alte comic_image_cache.json)
$cb = $comic->imageUpdatedAt ? '?c=' . $comic->imageUpdatedAt : '';

// Bild-Pfade
$imagePath     = "{$baseUrl}/assets/images/comic/lowres/{$comicId}.webp{$cb}";
$fallbackPath  = "{$baseUrl}/assets/images/layout/thumbnails/placeholder.jpg";
$thumbnailPath = "{$baseUrl}/assets/images/comic/thumbnails/{$comicId}.webp{$cb}";
?>

<!-- Header wird später als Komponente eingebunden -->
<?php include __DIR__ . '/../components/_public_header.phtml'; ?>

<main class="content-area">
    <article class="comic">
        <header>
            <?php if ($comic->chapterId !== null) { ?>
                <h2 class="tinyheader">Kapitel <?php echo \htmlspecialchars((string) $comic->chapterId); ?></h2>
            <?php } ?>
            <h1><?php echo \htmlspecialchars($pageTitle); ?></h1>
        </header>

        <!-- Obere Navigation -->
        <nav class="comicnav topnav">
            <a href="<?php echo $baseUrl; ?>/comic/<?php echo $nav['first']; ?>"
               class="navarrow navbegin <?php echo $nav['prev'] === null ? 'disabled' : ''; ?>" title="Erste Seite">
                <span class="nav-wrapper">Erste</span>
            </a>
            <a href="<?php echo $nav['prev'] ? $baseUrl . '/comic/' . $nav['prev'] : '#'; ?>"
               class="navarrow navprev <?php echo $nav['prev'] === null ? 'disabled' : ''; ?>" title="Vorherige Seite">
                <span class="nav-wrapper">Zurück</span>
            </a>
            <a href="<?php echo $baseUrl; ?>/archiv" class="navarchive" title="Zum Archiv">
                Archiv
            </a>
            <a href="<?php echo $nav['next'] ? $baseUrl . '/comic/' . $nav['next'] : '#'; ?>"
               class="navarrow navnext <?php echo $nav['next'] === null ? 'disabled' : ''; ?>" title="Nächste Seite">
                <span class="nav-wrapper">Weiter</span>
            </a>
            <a href="<?php echo $baseUrl; ?>/"
               class="navarrow navend <?php echo $nav['next'] === null ? 'disabled' : ''; ?>" title="Neueste Seite">
                <span class="nav-wrapper">Neueste</span>
            </a>
        </nav>

        <!-- Comic Bild -->
        <div class="comic-image-container">
            <img id="comic-image" class="comic-image"
                 src="<?php echo \htmlspecialchars($imagePath); ?>"
                 data-english-filename="<?php echo \htmlspecialchars($comic->originalUrl); ?>"
                 data-english-sketch-url-from-cache="<?php echo \htmlspecialchars($comic->sketchUrl); ?>"
                 alt="<?php echo \htmlspecialchars($pageTitle); ?>"
                 onerror="this.onerror=null; this.src='<?php echo $fallbackPath; ?>';">
        </div>

        <!-- Untere Navigation -->
        <nav class="comicnav bottomnav">
            <button type="button" class="navarrow nav-lang-toggle" id="lang-toggle-btn"
                    onclick="window.runOriginalProbingLogic(document.getElementById('comic-image'), this)">
                <span class="nav-wrapper">EN</span>
            </button>
            <button type="button" class="navarrow nav-report-issue" id="open-report-modal"
                    data-comic-id="<?php echo \htmlspecialchars($comicId); ?>">
                <span class="nav-wrapper">Fehler melden</span>
            </button>
            <button type="button" class="bookmark" id="add-bookmark"
                    data-id="<?php echo \htmlspecialchars($comicId); ?>"
                    data-page="<?php echo \htmlspecialchars($pageTitle); ?>"
                    data-permalink="<?php echo $baseUrl; ?>/comic/<?php echo \htmlspecialchars($comicId); ?>"
                    data-thumb="<?php echo \htmlspecialchars($thumbnailPath); ?>"
                    title="Diese Seite als Lesezeichen speichern">
                Lesezeichen
            </button>
        </nav>

        <div class="below-nav">
            <div class="permalink">
                Permalink: <a href="<?php echo $baseUrl; ?>/comic/<?php echo \htmlspecialchars($comicId); ?>"><?php echo $baseUrl; ?>/comic/<?php echo \htmlspecialchars($comicId); ?></a>
            </div>
            <div class="nav-instruction">
                <span class="nav-instruction-content jsdep">Du kannst auch die Pfeiltasten verwenden, um zu blättern.</span>
            </div>
        </div>

        <!-- Transkript -->
        <?php if ($comic->transcript !== null && $comic->transcript !== '') { ?>
            <aside class="transcript">
                <div class="transcript-header">
                    <h3>Transkript</h3>
                </div>
                <div class="transcript-content">
                    <?php echo $comic->transcript; // HTML wurde vom Summernote-Editor und Backend validiert?>
                </div>
            </aside>
        <?php } ?>

    </article>
</main>

<!-- Footer wird später als Komponente eingebunden -->
