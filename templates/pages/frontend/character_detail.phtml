// Das kleine Profilbild für den Header
$profilePicUrl = $character->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$character->picUrl}" : $placeholderPath;

// Bestimme das Hauptbild für die große Ansicht links
if ($character->mainPic) {
    $picUrl = "{$baseUrl}/assets/images/characters/main/{$character->mainPic}";
} else {
    $picUrl = $profilePicUrl; // Fallback, falls kein großes Bild existiert
}

include __DIR__ . '/../../components/frontend/_public_header.phtml';
