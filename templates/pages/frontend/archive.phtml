<?php

declare(strict_types=1);

/**
 * @var array  $groupedComics
 * @var array  $chapterDetails
 * @var string $pageTitle
 * @var array  $settings
 */
$baseUrl         = \rtrim($settings['base_url'], '/');
$placeholderPath = "{$baseUrl}/assets/images/layout/thumbnails/placeholder.jpg";

include __DIR__ . '/../../components/frontend/_public_header.phtml';
?>

<main class="content-area">
    <article style="width: 100%; max-width: 900px; margin: 0 auto;">
        <header>
            <h1 class="page-header">TwoKinds Archiv</h1>
        </header>

        <div class="instructions jsdep">Klicken Sie auf eine Kapitelüberschrift, um das Kapitel zu erweitern.</div>

        <?php if (empty($groupedComics)) { ?>
            <p style="text-align: center; margin: 40px 0;">Es sind noch keine Comics im Archiv vorhanden.</p>
        <?php } else { ?>
            <?php foreach ($groupedComics as $chapterId => $chapterComics) {
                // Hole Titel und Beschreibung aus der Datenbank, falls vorhanden
                $chapTitle = 'Dieses Kapitel wird im Moment bearbeitet.';
                $chapDesc  = 'Die Informationen zu diesem Kapitel werden noch erstellt.';

                if (isset($chapterDetails[$chapterId])) {
                    $chapTitle = $chapterDetails[$chapterId]->title;
                    if ($chapterDetails[$chapterId]->description !== '') {
                        $chapDesc = $chapterDetails[$chapterId]->description;
                    }
                }
                ?>
                <section class="chapter collapsible-section"
                         data-ch-id="<?php echo \htmlspecialchars((string) $chapterId); ?>">
                    <h2 class="collapsible-header">
                        <?php echo \htmlspecialchars($chapTitle); ?>
                        <span class="arrow-left jsdep"></span>
                    </h2>

                    <p><?php echo $chapDesc; ?></p>

                    <div class="collapsible-content">
                        <aside class="chapter-links">
                            <?php \usort($chapterComics, fn ($a, $b) => $a->id->value <=> $b->id->value);
                foreach ($chapterComics as $comic) {
                    $comicId   = $comic->id->value;
                    $cb        = $comic->imageUpdatedAt ? '?c=' . $comic->imageUpdatedAt : '';
                    $thumbDisk = "{$appRoot}/public/assets/images/comic/thumbnails/{$comicId}.webp";
                    $thumbPath = \file_exists($thumbDisk)
                        ? "{$baseUrl}/assets/images/comic/thumbnails/{$comicId}.webp{$cb}"
                        : "{$baseUrl}/assets/images/layout/thumbnails/in_translation.webp";
                    $dateObj     = \DateTimeImmutable::createFromFormat('Ymd', \substr($comicId, 0, 8));
                    $displayDate = $dateObj ? $dateObj->format('d.m.Y') : $comicId;
                    $tooltipText = "Seite vom {$displayDate}" . ($comic->name !== '' ? ": {$comic->name}" : '');
                    ?>
                                <a href="<?php echo $baseUrl; ?>/comic/<?php echo $comicId; ?>" title="<?php echo \htmlspecialchars($tooltipText); ?>">
                                    <span><?php echo \htmlspecialchars($tooltipText); ?></span>
                                    <!-- Lazy Loading & Fallback via archive.js (data-src) -->
                                    <img src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="
                                         data-src="<?php echo \htmlspecialchars($thumbPath); ?>"
                                         alt="<?php echo \htmlspecialchars($tooltipText); ?>">
                                </a>
                            <?php } ?>
                        </aside>
                    </div>
                </section>
            <?php } ?>
        <?php } ?>
    </article>
</main>

<!-- Das Archiv-Script einbinden -->
<script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>"
        src="<?php echo $baseUrl; ?>/assets/js/archive.min.js"></script>

<?php include __DIR__ . '/../../components/frontend/_public_footer.phtml'; ?>
