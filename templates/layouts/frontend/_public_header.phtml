    <script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>">
    (function() {
        var t = localStorage.getItem('themePref');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (t === '2' || (t !== '1' && d)) document.body.classList.add('theme-night');
        else document.body.classList.remove('theme-night');

        // Desktop-Ansicht sofort setzen, um FOUC zu vermeiden
        var fd = localStorage.getItem('forceDesktop');
        if (fd === 'true') document.documentElement.classList.add('force-desktop');
    })();

