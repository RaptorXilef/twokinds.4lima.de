<?php

declare(strict_types=1);

use App\Core\Entity\Report;

/**
 * @var string   $baseUrl
 * @var Report[] $allReports
 */
?>

<section id="section-reports"
         class="content-section">
    <div class="table-controls actions-bar"
         style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 15px; align-items: center;">
        <div class="search-wrapper"
             style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <select id="report-status-filter"
                    style="padding: 6px 10px; border-radius: 4px; border: 1px solid var(--border-medium); background: var(--table-row-even); color: var(--text-color);">
                <option value="all">Alle Status anzeigen</option>
                <option value="open"
                        selected>Nur Offene</option>
                <option value="closed">Erledigte</option>
                <option value="spam">Spam</option>
            </select>
            <select id="report-per-page"
                    style="padding: 6px 10px; border-radius: 4px; border: 1px solid var(--border-medium); background: var(--table-row-even); color: var(--text-color);">
                <option value="5">5 Einträge</option>
                <option value="15"
                        selected>15 Einträge</option>
                <option value="50">50 Einträge</option>
                <option value="all">Alle</option>
            </select>
            <input type="text"
                   id="report-search"
                   placeholder="Reports durchsuchen..."
                   style="min-width: 250px;">
        </div>
    </div>

    <div class="sitemap-table-container">
        <table class="admin-table report-editor-table"
               id="reports-table">
            <thead>
                <tr>
                    <th style="width: 150px;">Datum</th>
                    <th style="width: 100px;">Comic ID</th>
                    <th style="width: 120px;">Typ</th>
                    <th>Melder & Text</th>
                    <th style="width: 100px;">Status</th>
                    <th style="width: 80px; text-align: right;">Aktion</th>
                </tr>
            </thead>
            <tbody>
                <?php if (empty($allReports)) { ?>
                    <tr>
                        <td colspan="6"
                            class="empty-table-message">Es liegen keine Meldungen vor.</td>
                    </tr>
                <?php } else { ?>
                    <?php foreach ($allReports as $rep) {
                        $statusColor = match ($rep->status) {
                            'open'   => '#ffc107',
                            'closed' => '#28a745',
                            'spam'   => '#dc3545',
                            default  => 'grey'
                        };
                        $statusText = match ($rep->status) {
                            'open'   => 'Offen',
                            'closed' => 'Erledigt',
                            'spam'   => 'Spam',
                            default  => $rep->status
                        };

                        // FIX: ComicID kann null sein!
                        $comicIdStr = $rep->comicId ? $rep->comicId->value : '';

                        $reportData = \json_encode([
                            'id'            => $rep->id->value,
                            'comicId'       => $comicIdStr,
                            'date'          => $rep->date->format('d.m.Y H:i'),
                            'submitter'     => $rep->submitterName,
                            'type'          => $rep->type,
                            'description'   => $rep->description,
                            'suggestion'    => $rep->transcriptSuggestion,
                            'original'      => $rep->transcriptOriginal,
                            'screenshotUrl' => $rep->screenshotUrl,
                            'debug'         => \html_entity_decode($rep->debugInfo, \ENT_QUOTES, 'UTF-8'), // Dekodiert &quot; für sauberes JSON im Textfeld
                            'status'        => $rep->status,
                        ], \JSON_HEX_APOS | \JSON_HEX_QUOT);
                        ?>
                        <tr data-status="<?php echo \htmlspecialchars($rep->status); ?>">
                            <td><?php echo $rep->date->format('d.m.Y H:i'); ?></td>
                            <td class="mono">
                                <?php if ($comicIdStr !== '') { ?>
                                    <a href="<?php echo $baseUrl; ?>/comic/<?php echo \htmlspecialchars($comicIdStr); ?>" target="_blank">
                                        <?php echo \htmlspecialchars($comicIdStr); ?>
                                    </a>
                                <?php } else { ?>
                                    <span style="color: var(--text-color-faded); font-style: italic;">Allgemein</span>
                                <?php } ?>
                            </td>
                            <td><strong><?php echo \htmlspecialchars(\ucfirst($rep->type)); ?></strong></td>
                            <td>
                                <strong><?php echo \htmlspecialchars($rep->submitterName); ?></strong>
                                <div class="description-preview"
                                     style="max-height: 2.5em; font-size: 0.85em;">
                                    <?php echo \htmlspecialchars(\strip_tags($rep->description ?: $rep->transcriptSuggestion)); ?>
                                </div>
                            </td>
                            <td>
                                <span style="display: inline-block; padding: 2px 6px; font-size: 0.85em; font-weight: bold; border-radius: 4px; background: <?php echo $statusColor; ?>; color: #000;">
                                    <?php echo $statusText; ?>
                                </span>
                            </td>
                            <td class="actions-cell">
                                <button type="button"
                                        class="button edit btn-view-report"
                                        data-payload='<?php echo $reportData; ?>'
                                        title="Report prüfen">
                                    <i class="fa-solid fa-search"></i>
                                </button>
                            </td>
                        </tr>
                    <?php } ?>
                <?php } ?>
            </tbody>
        </table>
    </div>
    <div id="report-pagination"
         style="display: flex; gap: 5px; justify-content: center; margin-top: 20px; flex-wrap: wrap;"></div>
</section>
