<section id="section-media" class="content-section">
    <!-- Sub-Navigation & Suche für die Media-Galerie -->
    <div style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 15px; border-bottom: 2px solid var(--border-medium); padding-bottom: 15px; align-items: center; justify-content: space-between;">
        <div style="display: flex; gap: 10px;">
            <button class="button media-tab-btn active" data-type="characters">Charaktere & Profile</button>
            <button class="button edit media-tab-btn" data-type="comics">Comic-Seiten (Medien)</button>
        </div>
        <div class="search-wrapper" style="flex: 1; min-width: 250px; display: flex; justify-content: flex-end;">
            <input type="text" id="media-search" placeholder="Bilder durchsuchen (Name oder ID)..." style="width: 100%; max-width: 350px;">
        </div>
    </div>

    <!-- ANSICHT 1: Charaktere -->
    <div id="media-view-characters" class="media-view">
        <div id="media-drop-zone" class="drag-drop-zone" style="margin-bottom: 20px; padding: 30px 20px; border: 3px dashed var(--link-color); background: var(--table-row-even); text-align: center; cursor: pointer; border-radius: 8px;">
            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 3em; color: var(--link-color); margin-bottom: 10px;"></i>
            <h3 style="margin:0;">Charakter-Bilder hier ablegen</h3>
            <p style="color: var(--text-color-light);">Oder klicken, um Dateien auszuwählen (werden automatisch als WebP gespeichert).</p>
            <input type="file" id="media-upload-input" accept="image/*" multiple style="display: none;">
        </div>
        <div id="media-gallery-characters" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;"></div>
    </div>

    <!-- ANSICHT 2: Comics -->
    <div id="media-view-comics" class="media-view" style="display: none;">
        <div style="padding: 15px; background: var(--status-orange-bg); color: var(--status-orange-text); border-radius: 6px; margin-bottom: 20px;">
            <i class="fa-solid fa-triangle-exclamation"></i> <strong>Achtung:</strong> Das Löschen hier entfernt die Bilder physisch vom Server. Der Eintrag in der Comic-Datenbank bleibt erhalten!
        </div>
        <div id="media-gallery-comics" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px;"></div>
    </div>
</section>
