<script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>">
document.addEventListener('DOMContentLoaded', () => {
    // Die Datenbank aus PHP als intelligentes Wörterbuch
    const serverComics = <?php echo \json_encode($comicDictionary, \JSON_UNESCAPED_UNICODE | \JSON_HEX_APOS | \JSON_HEX_QUOT); ?>;

    const grid = document.getElementById('bookmarks-grid');
    const noMsg = document.getElementById('no-bookmarks-msg');
    const contentWrapper = document.getElementById('bookmarks-content');
    const countBadge = document.getElementById('bookmark-count-badge');
    const btnClearAll = document.getElementById('btn-clear-all-bookmarks');
    const sortSelect = document.getElementById('bookmark-sort');

    function renderBookmarks() {
        const bookmarksMap = JSON.parse(localStorage.getItem('comicBookmarksMap') || '{}');
        let bookmarks = Object.values(bookmarksMap);

        // Bereinigen: Lösche Lesezeichen, die auf dem Server nicht mehr existieren
        const validBookmarks = [];
        let hasInvalid = false;
        bookmarks.forEach(bm => {
            if (serverComics[bm.id]) {
                validBookmarks.push(bm);
            } else {
                delete bookmarksMap[bm.id];
                hasInvalid = true;
            }
        });

        if (hasInvalid) {
            localStorage.setItem('comicBookmarksMap', JSON.stringify(bookmarksMap));
        }

        bookmarks = validBookmarks;
        countBadge.textContent = bookmarks.length;

        if (bookmarks.length === 0) {
            contentWrapper.style.display = 'none';
            noMsg.style.display = 'block';
            return;
        }

        contentWrapper.style.display = 'block';
        noMsg.style.display = 'none';

        // Sortierung anwenden
        const sortMode = sortSelect.value;
        bookmarks.sort((a, b) => {
            if (sortMode === 'added_desc') return (b.added || 0) - (a.added || 0);
            if (sortMode === 'added_asc') return (a.added || 0) - (b.added || 0);
            if (sortMode === 'page_desc') return b.id.localeCompare(a.id); // Timeline: Neueste oben
            if (sortMode === 'page_asc') return a.id.localeCompare(b.id); // Timeline: Älteste oben
            return 0;
        });

        grid.innerHTML = '';

        bookmarks.forEach(bm => {
            const dbData = serverComics[bm.id];
            const addedDateStr = new Date(bm.added).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });

            const card = document.createElement('div');
            card.className = 'bookmark-card'; // Nutzt unser neues CSS von oben!

            // Bild
            const link = document.createElement('a');
            link.href = dbData.permalink;
            link.style.display = 'block';
            link.style.width = '100%';
            link.style.aspectRatio = '1 / 1.35';
            link.style.overflow = 'hidden';
            link.style.backgroundColor = 'var(--page-bg)';
            // Hier kein opacity:0 mehr! Es lädt sofort sichtbar.
            link.innerHTML = `<img src="${dbData.thumb}" alt="${dbData.title}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">`;

            // Info-Bereich
            const info = document.createElement('div');
            info.style.padding = '12px 10px';
            info.style.textAlign = 'center';
            info.style.flexGrow = '1';
            info.style.display = 'flex';
            info.style.flexDirection = 'column';
            info.style.justifyContent = 'space-between';

            let typeBadge = '';
            if (dbData.type.toLowerCase() !== 'comicseite') {
                typeBadge = `<span style="font-size: 0.75em; font-weight: bold; background: var(--status-info-bg); color: var(--status-info-text); border: 1px solid var(--status-info-border); padding: 2px 8px; border-radius: 12px; margin-bottom: 5px; display: inline-block; text-transform: uppercase;">${dbData.type}</span><br>`;
            }

            info.innerHTML = `
                <div>
                    ${typeBadge}
                    <div style="font-weight: bold; font-size: 0.95em; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-color);" title="${dbData.title}">${dbData.title}</div>
                    <div style="font-size: 0.85em; color: var(--text-color-light); margin-bottom: 8px;">Kapitel ${dbData.chapter} <span style="opacity: 0.5;">|</span> ${dbData.date}</div>
                </div>
                <div style="font-size: 0.75em; color: var(--text-color-faded); border-top: 1px dashed var(--border-medium); padding-top: 8px; margin-top: auto;">
                    <i class="fa-regular fa-clock"></i> Gemerkt: ${addedDateStr}
                </div>
            `;

            // Löschen Button
            const delBtn = document.createElement('button');
            delBtn.className = 'delete-btn'; // Nutzt das Hover-CSS
            delBtn.innerHTML = '<i class="fa-solid fa-times"></i>';
            delBtn.title = "Lesezeichen entfernen";
            delBtn.style.position = 'absolute';
            delBtn.style.top = '5px';
            delBtn.style.right = '5px';
            delBtn.style.width = '28px';
            delBtn.style.height = '28px';
            delBtn.style.borderRadius = '50%';
            delBtn.style.border = '1px solid #bd2130';
            delBtn.style.backgroundColor = '#dc3545';
            delBtn.style.color = '#fff';
            delBtn.style.cursor = 'pointer';
            delBtn.style.display = 'flex';
            delBtn.style.alignItems = 'center';
            delBtn.style.justifyContent = 'center';
            delBtn.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';

            delBtn.onmouseenter = () => delBtn.style.backgroundColor = '#c82333';
            delBtn.onmouseleave = () => delBtn.style.backgroundColor = '#dc3545';

            delBtn.onclick = (e) => {
                e.preventDefault();
                delete bookmarksMap[bm.id];
                localStorage.setItem('comicBookmarksMap', JSON.stringify(bookmarksMap));
                renderBookmarks();
            };

            card.appendChild(link);
            card.appendChild(info);
            card.appendChild(delBtn);
            grid.appendChild(card);
        });
    }

    if (sortSelect) {
        sortSelect.addEventListener('change', renderBookmarks);
    }

    if (btnClearAll) {
        btnClearAll.addEventListener('click', () => {
            if (confirm('Möchtest du wirklich ALLE deine lokalen Lesezeichen unwiderruflich löschen?')) {
                localStorage.removeItem('comicBookmarksMap');
                renderBookmarks();
            }
        });
    }

    // Initiales Rendern
    renderBookmarks();
});
</script>

