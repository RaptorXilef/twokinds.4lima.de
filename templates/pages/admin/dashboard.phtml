<script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>">
document.addEventListener('DOMContentLoaded', () => {
    // Logout Logic
    const logoutBtn = document.getElementById('admin-logout-btn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const formData = new window.FormData(); // TODO Entferne window. wenn in eigener JS-Datei
            formData.append('csrf_token', document.querySelector('meta[name="csrf-token"]').content);

            const response = await fetch('<?php echo $baseUrl; ?>/api/admin_logout', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            if (data.success) {
                window.location.href = '<?php echo $baseUrl; ?>/' + data.redirect;
            }
        });
    }
});
</script>

<script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>" src="<?php echo $asset->url('assets/js/common.js'); ?>"></script>
