{
  "name": "@raptorxilef/twokinds.4lima.de",
  "version": "6.3.0",
  "description": "OOP/DDD-basiertes System zur Verwaltung und Anzeige der übersetzten Comicseiten von TwoKinds",
  "type": "module",
  "author": "Felix Maywald <RaptorXilef>",
  "license": "Copyright (c) 2026 Felix Maywald alias RaptorXilef. All rights reserved.",
  "engines": {
    "node": ">=26.4.0",
    "npm": ">=11.11.0"
  },
  "allowScripts": {
    "sharp": true,
    "chromedriver": true,
    "@parcel/watcher": true
  },
  "scripts": {
    "// --- PHASE 0: SETUP & LIFECYCLE ---": "",
    "prepare": "husky",
    "collect": "node scripts/collect-all.js",
    "collect-llm": "node scripts/collect-all-llm.js",
    "extract": "node scripts/extract-all.js",
    "legacy:collect": "pwsh.exe -ExecutionPolicy Bypass -Command \"& (Get-Item scripts/Collect-All*.ps1).FullName\"",
    "collect-info": "pwsh.exe -Command \"Get-Location; Get-ChildItem scripts\"",
    "// --- PHASE 1: DEVELOPMENT (CURRENT: SASS/LEGACY) ---": "Priorität auf Sass-Watch",
    "dev": "npm run legacy:css:watch",
    "images:optimize": "node scripts/optimize-images.js",
    "legacy:css:watch": "sass --watch src/assets/scss:public/assets/css --style=expanded --source-map",
    "legacy:css:compile": "sass src/assets/scss:public/assets/css --style=expanded --no-source-map",
    "legacy:css:minify": "node scripts/legacy-minify-css.js",
    "legacy:css:build": "npm run legacy:css:compile && npm run legacy:css:minify",
    "legacy:js:build": "node scripts/legacy-minify-js.js",
    "legacy:build": "npm npm run legacy:js:build && run legacy:css:build",
    "legacy:images:optimize": "npm run images:optimize",
    "// --- PHASE 2: MODERN BUILD (VITE) ---": "Vite wird später aktiviert",
    "vite:dev": "vite --host",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "// --- PHASE 3: TESTING ---": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "node_test": "node --test",
    "// --- PHASE 4: QUALITY & LINTING (SINGLE TOOLS) ---": "",
    "chk:biome": "biome check --write .",
    "chk:biome:lint": "biome lint .",
    "chk:css": "stylelint \"**/*.scss\"",
    "chk:html": "markuplint \"**/*.html\"",
    "chk:spell": "cspell lint \"**\" --no-progress --show-suggestions",
    "chk:md": "markdownlint-cli2",
    "chk:a11y": "axe public/index.html",
    "chk:a11y:url": "axe http://localhost/php-js-dev-env-blueprint",
    "// --- PHASE 5: FIXING (SINGLE TOOLS) ---": "",
    "fix:biome": "biome check --fix .",
    "fix:biome:format": "biome format --write .",
    "fix:css": "stylelint \"**/*.scss\" --fix",
    "// --- PHASE 6: RELEASE & CI ---": "",
    "release": "release-it",
    "release:alpha": "release-it --preRelease=alpha",
    "release:beta": "release-it --preRelease=beta",
    "release:rc": "release-it --preRelease=rc",
    "release:patch": "release-it --increment=patch --ci",
    "release:init": "release-it --first-release",
    "release:show_token": "echo $GITHUB_TOKEN",
    "changelog:rebuild": "conventional-changelog --config changelog-config.js -i CHANGELOG.md -s -r 0",
    "ci:test": "vitest run --ci",
    "ci:release:test": "release-it --dry-run --ci",
    "ci:lint:a11y": "axe --ci --tags wcag2a,wcag2aa http://localhost:3000",
    "// --- MASTER COMMANDS (JS/FE) ---": "",
    "chk": "npm run qa",
    "fix": "npm run fix:biome && npm run fix:css",
    "qa": "npm run chk:biome && npm run chk:css && npm run chk:html && npm run chk:spell && npm run chk:md && npm run test"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cspell/dict-de-de": "^4.1.2",
    "@markuplint/html-spec": "^4.18.0",
    "@release-it/conventional-changelog": "^11.0.0",
    "@vitest/ui": "^4.1.5",
    "chromedriver": "^151.0.1",
    "clean-css-cli": "^5.6.3",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cspell": "^10.0.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.1",
    "markuplint": "^4.18.1",
    "release-it": "^20.0.1",
    "sass-embedded": "^1.99.0",
    "sharp": "^0.35.0",
    "stylelint": "^17.9.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "terser": "^5.46.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "adm-zip": ">=0.6.0",
    "brace-expansion": ">=2.0.1",
    "js-yaml": ">=4.1.0",
    "@ungap/structured-clone": ">=1.3.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "lint-staged": {
    "*.php": [
      "vendor/bin/phpcs",
      "vendor/bin/phpstan analyze",
      "vendor/bin/phpmd analyze --format text --ruleset phpmd.xml.dist",
      "vendor/bin/rector process --dry-run",
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --no-interaction"
    ],
    "*.json": "biome check --write --no-errors-on-unmatched",
    "*.js": [
      "biome check --write --no-errors-on-unmatched",
      "vitest related --run"
    ],
    "*.scss": "stylelint --fix",
    "*.html": "markuplint",
    "*.md": "markdownlint-cli2 --fix",
    "*": "cspell lint --no-must-find-files --no-progress"
  }
}
