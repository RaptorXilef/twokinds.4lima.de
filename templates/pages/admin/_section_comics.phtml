<?php

declare(strict_types=1);

use App\Core\Entity\ComicPage;

/**
 * @var string      $baseUrl
 * @var ComicPage[] $comics
 * @var array       $perms
 */
?>

<!-- ========================================== -->
<!-- SECTION: COMICS                            -->
<!-- ========================================== -->

<div class="table-controls actions-bar d-flex flex-wrap justify-between gap-15 align-center">
    <div class="top-actions">
        <?php if ($perms['comic_edit']) { ?>
            <button type="button"
                    class="button add"
                    id="btn-add-comic">
                <i class="fa-solid fa-plus"></i> Neuen Comic hinzufügen
            </button>
        <?php } ?>
        <?php if ($perms['comic_del']) { ?>
            <button type="button"
                    class="button button-orange"
                    id="btn-restore-deleted-comic"
                    title="Zuletzt gelöschten Comic wiederherstellen">
                <i class="fa-solid fa-trash-arrow-up"></i> Papierkorb
            </button>
        <?php } ?>
    </div>
    <div class="search-wrapper d-flex gap-10 align-center flex-wrap">
        <select id="comic-per-page"
                class="dt-per-page-select">
            <option value="5">5 Einträge</option>
            <option value="10">10 Einträge</option>
            <option value="15"
                    selected>15 Einträge</option>
            <option value="25">25 Einträge</option>
            <option value="50">50 Einträge</option>
            <option value="75">75 Einträge</option>
            <option value="100">100 Einträge</option>
            <option value="250">250 Einträge</option>
            <option value="500">500 Einträge</option>
            <option value="1000">1000 Einträge</option>
            <option value="all">Alle</option>
        </select>
        <input type="text"
               id="comic-search"
               placeholder="Comics durchsuchen (ID, Name, Transkript)..."
               class="min-w-250">
    </div>
</div>

<div class="sitemap-table-container">
    <table class="admin-table comic-editor-table">
        <thead>
            <tr>
                <th class="col-id-long">ID / Datum</th>
                <th class="col-avatar">Thumbnail</th>
                <th class="col-type">Typ & Kapitel</th>
                <th class="col-main">Titel & Transkript</th>
                <th class="col-status">Status</th>
                <th class="col-actions">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            <?php if (empty($comics)) { ?>
                <tr>
                    <td colspan="6"
                        class="empty-table-message">Keine Comics gefunden.</td>
                </tr>
            <?php } else { ?>
                <?php foreach ($comics as $comic) {
                    $cId        = $comic->id->value;
                    $cb         = $comic->imageUpdatedAt ? '?c=' . $comic->imageUpdatedAt : '';
                    $thumbPath  = "{$baseUrl}/assets/images/comics/thumbnails/{$cId}.webp{$cb}";
                    $socialPath = "{$baseUrl}/assets/images/comics/social/{$cId}.jpg{$cb}";

                    // Alle Daten für JS bereitstellen
                    $charIds   = \array_map(fn ($id) => $id->value, $comic->characterIds);
                    $comicData = \json_encode([
                        'id'          => $cId,
                        'type'        => $comic->type,
                        'name'        => $comic->name,
                        'chapterId'   => $comic->chapterId ?? '',
                        'originalUrl' => $comic->originalUrl,
                        'sketchUrl'   => $comic->sketchUrl,
                        'transcript'  => $comic->transcript ?? '',
                        'characters'  => $charIds,
                        'users'       => $comic->userIds ?? [],
                    ], \JSON_HEX_APOS | \JSON_HEX_QUOT);

                    // Fehlende Dinge ermitteln
                    $missing = [];
                    if ($comic->name === '') {
                        $missing[] = 'Titel';
                    }
                    if ($comic->chapterId === null || $comic->chapterId === '') {
                        $missing[] = 'Kapitel';
                    }
                    if ($comic->originalUrl === '') {
                        $missing[] = 'Original-Bild';
                    }
                    if ($comic->sketchUrl === '') {
                        $missing[] = 'Sketch';
                    }
                    if ($comic->transcript === null || $comic->transcript === '') {
                        $missing[] = 'Transkript';
                    }
                    if (empty($comic->characterIds)) {
                        $missing[] = 'Charaktere';
                    }
                    ?>
                    <tr>
                        <td class="mono"><?php echo \htmlspecialchars($cId); ?></td>
                        <td>
                            <img src="<?php echo \htmlspecialchars($thumbPath); ?>"
                                 class="comic-thumbnail"
                                 loading="lazy">
                            <!-- Social Media Preview (Mini) -->
                            <img src="<?php echo \htmlspecialchars($socialPath); ?>"
                                 class="hover-zoom-trigger hide-on-error comic-social-thumb"
                                 loading="lazy"
                                 title="Social Media Thumbnail (Klicken zum Vergrößern)">
                        </td>
                        <td>
                            <span class="comic-type-display"><?php echo \htmlspecialchars($comic->type); ?></span>
                            <?php if ($comic->chapterId) { ?>
                                <small>Kapitel <?php echo \htmlspecialchars($comic->chapterId); ?></small>
                            <?php } ?>
                        </td>
                        <td>
                            <strong><?php echo \htmlspecialchars($comic->name !== '' ? $comic->name : 'Kein Titel'); ?></strong>
                            <?php if ($comic->transcript) { ?>
                                <div class="description-preview"><?php echo \strip_tags($comic->transcript); ?></div>
                            <?php } ?>
                        </td>
                        <!-- Die Status-Spalte -->
                        <td>
                            <?php if (empty($missing)) { ?>
                                <span class="status-badge complete"><i class="fa-solid fa-check"></i> Komplett</span>
                            <?php } else { ?>
                                <div class="d-flex flex-wrap gap-5">
                                    <?php foreach ($missing as $miss) { ?>
                                        <span class="status-badge missing">Fehlt: <?php echo $miss; ?></span>
                                    <?php } ?>
                                </div>
                            <?php } ?>
                        </td>
                        <td class="actions-cell">
                            <form>
                                <?php if ($perms['comic_del']) { ?>
                                    <button type="button"
                                            class="button button-orange btn-undo-comic"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            title="Rückgängig / Wiederherstellen (Toggle)">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>
                                <?php } ?>
                                <?php if ($perms['comic_edit']) { ?>
                                    <button type="button"
                                            class="button edit btn-edit-comic"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            data-payload='<?php echo $comicData; ?>'
                                            title="Bearbeiten">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                <?php } ?>
                                <?php if ($perms['comic_del']) { ?>
                                    <button type="button"
                                            class="button delete btn-delete-comic"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            title="Löschen">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                <?php } ?>
                            </form>
                        </td>
                    </tr>
                <?php } ?>
            <?php } ?>
        </tbody>
    </table>
</div>

<div id="comic-pagination"
     class="pagination-container d-flex gap-5 justify-center mt-20 flex-wrap">
    <!-- Die Buttons werden hier per JS generiert -->
</div>
