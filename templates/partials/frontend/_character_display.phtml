<?php

declare(strict_types=1);

/**
 * Erwartete Variablen:
 * @var array $characters (Alle Charaktere aus der DB)
 * @var array $groups (Alle Gruppen aus der DB)
 * @var array|null $limitToIds (Array aus IDs, falls nur bestimmte gezeigt werden sollen, sonst null)
 * @var string $baseUrl
 */
$limitToIds ??= null;
$placeholderPath = "{$baseUrl}/assets/images/system/placeholder.webp";

// 1. Filtern und Mappen
$charMap = [];
$filteredChars = [];
foreach ($characters as $char) {
    if ($limitToIds !== null && !\in_array($char->id->value, $limitToIds, true)) {
        continue; // Charakter ist auf dieser Comic-Seite nicht vorhanden
    }
    $charMap[$char->id->value] = $char;
    $filteredChars[] = $char;
}

// Wenn nach dem Filtern nichts übrig ist (z.B. Filler-Seite), Modul gar nicht erst anzeigen
if (empty($filteredChars)) {
    return;
}

// 2. Tags-Map erstellen (für die Alphabetische Ansicht)
$tagsMap = [];
foreach ($groups as $group) {
    foreach ($group->characterIds as $cidObj) {
        if ($limitToIds === null || \in_array($cidObj->value, $limitToIds, true)) {
            $tagsMap[$cidObj->value][] = $group->name;
        }
    }
}

// 3. Alphabetische Liste sortieren
$alphaChars = $filteredChars;
\usort($alphaChars, fn ($a, $b) => \strcasecmp($a->name, $b->name));

$isFilteredView = $limitToIds !== null;
$headerText = $isFilteredView ? 'Charaktere auf dieser Seite' : 'Alle Charaktere';
?>

<div class="comic-characters-container interactive"
     id="char-display-wrapper"
     data-active-view="tags">

    <div class="char-display-header"
         style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="margin: 0;"><?php echo $headerText; ?></h3>
        <button type="button"
                id="toggle-char-view"
                class="button button-small"
                title="Ansicht umschalten">
            <i class="fas fa-th-list"></i> <span id = "toggle-view-text">Gruppierte Ansicht</span>
        </button>
    </div>

    <!-- LEER-STATUS MELDUNG -->
    <div id="char-filter-empty-msg"
         class="no-bookmarks"
         style="display: none; padding: 40px; margin-bottom: 20px;">
        <p style="margin:0; font-style:italic; color: var(--text-color-faded);">Keine Charaktere entsprechen deinen
            Filterkriterien.</p>
    </div>

    <!-- MODUS 1: GRUPPIERTE ANSICHT -->
    <div class="char-view-section view-grouped">
        <div class="character-list">
            <?php foreach ($groups as $group) {
                // Zuerst prüfen, ob wir in dieser Gruppe überhaupt gefilterte Charaktere haben
                $charsInThisGroup = [];
                foreach ($group->characterIds as $cidObj) {
                    if (isset($charMap[$cidObj->value])) {
                        $charsInThisGroup[] = $charMap[$cidObj->value];
                    }
                }
                if (empty($charsInThisGroup)) {
                    continue;
                } // Leere Gruppe überspringen!
                ?>
                <div class="character-group">
                    <h4><?php echo \htmlspecialchars($group->name); ?></h4>
                    <div class="character-group-list">
                        <?php foreach ($charsInThisGroup as $character) {
                            $picUrl = $character->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$character->picUrl}" : $placeholderPath;
                            $link = "{$baseUrl}/charaktere/" . \urlencode($character->id->value);
                            // Such-String generieren
                            $searchStr = \strtolower($character->name . ' ' . ($character->fullName ?? '') . ' ' . ($character->altNames ?? '') . ' ' . \strip_tags($character->description ?? ''));
                            ?>
                            <div class="character-item"
                                 data-search="<?php echo \htmlspecialchars($searchStr); ?>"
                                 data-gender="<?php echo \htmlspecialchars($character->gender ?? ''); ?>"
                                 data-age="<?php echo \htmlspecialchars($character->age ?? ''); ?>"
                                 data-rank="<?php echo \htmlspecialchars($character->rank ?? ''); ?>"
                                 data-species="<?php echo \htmlspecialchars($character->species ?? ''); ?>"
                                 data-subspecies="<?php echo \htmlspecialchars($character->subspecies ?? ''); ?>"
                                 data-languages="<?php echo \htmlspecialchars($character->languages ?? ''); ?>"
                                 data-haircolor="<?php echo \htmlspecialchars($character->hairColor ?? ''); ?>"
                                 data-eyecolor="<?php echo \htmlspecialchars($character->eyeColor ?? ''); ?>"
                                 data-furcolor="<?php echo \htmlspecialchars($character->furColor ?? ''); ?>">
                                <a href = "<?php echo $link; ?>">
                                <div class = "character-avatar-container">
                                <img src = "<?php echo \htmlspecialchars($picUrl); ?>" alt = "<?php echo \htmlspecialchars($character->name); ?>" loading = "lazy">
                                </div>
                                <p class = "character-name"><?php echo \htmlspecialchars($character->name); ?></p>
                                </a>
                            </div>
                        <?php } ?>
                    </div>
                </div>
            <?php } ?>
        </div>
    </div>

    <!-- MODUS 2: ALPHABETISCHE ANSICHT (TAGS) -->
    <div class="char-view-section view-tags">
        <div class="character-group">
            <h4>A - Z</h4>
            <div class="character-group-list">
                <?php foreach ($alphaChars as $character) {
                    $picUrl = $character->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$character->picUrl}" : $placeholderPath;
                    $link = "{$baseUrl}/charaktere/" . \urlencode($character->id->value);
                    $searchStr = \strtolower($character->name . ' ' . ($character->fullName ?? '') . ' ' . ($character->altNames ?? '') . ' ' . \strip_tags($character->description ?? ''));
                    ?>
                    <div class="character-item"
                         data-search="<?php echo \htmlspecialchars($searchStr); ?>"
                         data-gender="<?php echo \htmlspecialchars($character->gender ?? ''); ?>"
                         data-age="<?php echo \htmlspecialchars($character->age ?? ''); ?>"
                         data-rank="<?php echo \htmlspecialchars($character->rank ?? ''); ?>"
                         data-species="<?php echo \htmlspecialchars($character->species ?? ''); ?>"
                         data-subspecies="<?php echo \htmlspecialchars($character->subspecies ?? ''); ?>"
                         data-languages="<?php echo \htmlspecialchars($character->languages ?? ''); ?>"
                         data-haircolor="<?php echo \htmlspecialchars($character->hairColor ?? ''); ?>"
                         data-eyecolor="<?php echo \htmlspecialchars($character->eyeColor ?? ''); ?>"
                         data-furcolor="<?php echo \htmlspecialchars($character->furColor ?? ''); ?>">
                        <a href = "<?php echo $link; ?>">
                        <div class = "character-avatar-container">
                        <img src = "<?php echo \htmlspecialchars($picUrl); ?>" alt = "<?php echo \htmlspecialchars($character->name); ?>" loading = "lazy">
                        </div>
                        <p class = "character-name"><?php echo \htmlspecialchars($character->name); ?></p>

                        <div class = "character-tags">
                        <?php if (isset($tagsMap[$character->id->value])) {
                            foreach ($tagsMap[$character->id->value] as $tag) { ?>
                        <span class = "char-tag"><?php echo \htmlspecialchars($tag); ?></span>
                        <?php }
                            } ?>
                        </div>
                        </a>
                    </div>
                <?php } ?>
            </div>
        </div>
    </div>
</div>
