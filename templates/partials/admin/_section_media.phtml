<!-- Sub-Navigation & Suche für die Media-Galerie -->
<div class="d-flex flex-wrap gap-15 align-center justify-between mb-20 pb-15 border-bottom-2">
    <div class="d-flex gap-10">
        <button class="button media-tab-btn active"
                data-type="characters">Charaktere & Profile</button>
        <button class="button edit media-tab-btn"
                data-type="comics">Comic-Seiten (Medien)</button>
    </div>
    <div class="search-wrapper flex-1 d-flex justify-end min-w-250">
        <input type="text"
               id="media-search"
               placeholder="Bilder durchsuchen (Name oder ID)..."
               class="w-100 max-w-350">
    </div>
</div>

<!-- ANSICHT 1: Charaktere -->
<div id="media-view-characters"
     class="media-view">
    <div id="media-drop-zone"
         class="drag-drop-zone bg-even border-radius-8 mb-20 text-center">
        <i class="fa-solid fa-cloud-arrow-up media-drop-zone-icon"></i>
        <h3 class="mb-0 mt-0">Charakter-Bilder hier ablegen</h3>
        <p class="text-light">Oder klicken, um Dateien auszuwählen (werden automatisch als WebP gespeichert).</p>
        <input type="file"
               id="media-upload-input"
               accept="image/*"
               multiple
               class="hidden">
    </div>
    <div id="media-gallery-characters"
         class="grid-auto-150"></div>
</div>

<!-- ANSICHT 2: Comics -->
<div id="media-view-comics"
     class="media-view hidden">
    <div class="p-15 border-radius-6 mb-20 bg-warning text-warning">
        <i class="fa-solid fa-triangle-exclamation"></i> <strong>Achtung:</strong> Das Löschen hier entfernt die Bilder
        physisch vom Server. Der Eintrag in der Comic-Datenbank bleibt erhalten!
    </div>
    <div id="media-gallery-comics"
         class="grid-auto-180"></div>
</div>
