<?php

declare(strict_types=1);

use App\Core\Entity\Report;

/**
 * @var string   $baseUrl
 * @var Report[] $allReports
 */
?>
<div class="table-controls actions-bar d-flex flex-wrap justify-end gap-15 align-center">
    <div class="search-wrapper d-flex gap-10 align-center flex-wrap">
        <select id="report-status-filter">
            <option value="all">Alle Status anzeigen</option>
            <option value="open"
                    selected>Nur Offene</option>
            <option value="closed">Erledigte</option>
            <option value="spam">Spam</option>
        </select>
        <select id="report-per-page">
            <option value="5">5 Einträge</option>
            <option value="15"
                    selected>15 Einträge</option>
            <option value="50">50 Einträge</option>
            <option value="all">Alle</option>
        </select>
        <input type="text"
               id="report-search"
               placeholder="Reports durchsuchen..."
               class="min-w-250">
    </div>
</div>
<div class="sitemap-table-container">
    <table class="admin-table report-editor-table"
           id="reports-table">
        <thead>
            <tr>
                <th class="col-date">Datum</th>
                <th class="col-id">Comic ID</th>
                <th class="col-type">Typ</th>
                <th class="col-main">Melder & Text</th>
                <th class="col-status">Status</th>
                <th class="col-actions">Aktion</th>
            </tr>
        </thead>
        <tbody>
            <?php if (empty($allReports)) { ?>
                <tr>
                    <td colspan="6"
                        class="empty-table-message">Es liegen keine Meldungen vor.</td>
                </tr>
            <?php } else { ?>
                <?php foreach ($allReports as $rep) {
                    $statusText = match ($rep->status) {
                        'open'   => 'Offen',
                        'closed' => 'Erledigt',
                        'spam'   => 'Spam',
                        default  => $rep->status
                    };

                    // ComicID kann null sein!
                    $comicIdStr = $rep->comicId ? $rep->comicId->value : '';
                    $avatarImg  = $rep->submitterAvatarUrl
                        ? "{$baseUrl}/assets/images/avatars/{$rep->submitterAvatarUrl}"
                        : 'https://placehold.co/30x30?text=N/A';

                    $reportData = \json_encode([
                        'id'            => $rep->id->value,
                        'comicId'       => $comicIdStr,
                        'userId'        => $rep->userId,
                        'avatarUrl'     => $rep->submitterAvatarUrl,
                        'date'          => $rep->date->format('d.m.Y H:i'),
                        'submitter'     => $rep->submitterName,
                        'wantsCredit'   => (bool) $rep->wantsCredit,
                        'type'          => $rep->type,
                        'description'   => $rep->description,
                        'suggestion'    => $rep->transcriptSuggestion,
                        'original'      => $rep->transcriptOriginal,
                        'screenshotUrl' => $rep->screenshotUrl,
                        'debug'         => \html_entity_decode($rep->debugInfo, \ENT_QUOTES, 'UTF-8'),
                        'status'        => $rep->status,
                    ], \JSON_HEX_APOS | \JSON_HEX_QUOT);
                    ?>
                    <tr data-status="<?php echo \htmlspecialchars($rep->status); ?>">
                        <td><?php echo $rep->date->format('d.m.Y H:i'); ?></td>
                        <td class="mono">
                            <?php if ($comicIdStr !== '') { ?>
                                <a href="<?php echo $baseUrl; ?>/comic/<?php echo \htmlspecialchars($comicIdStr); ?>" target="_blank">
                                    <?php echo \htmlspecialchars($comicIdStr); ?>
                                </a>
                            <?php } else { ?>
                                <span class="text-faded font-italic">Allgemein</span>
                            <?php } ?>
                        </td>
                        <td><strong><?php echo \htmlspecialchars(\ucfirst($rep->type)); ?></strong></td>

                        <!-- Melder & Avatar -->
                        <td>
                            <!-- Avatar Anzeige in der Tabelle -->
                            <div class="d-flex align-center gap-10">
                                <img src="<?php echo \htmlspecialchars($avatarImg); ?>"
                                     class="report-table-avatar">
                                <div class="flex-1">
                                    <strong><?php echo \htmlspecialchars($rep->submitterName); ?></strong>
                                    <div class="report-desc-preview">
                                        <?php echo \htmlspecialchars(\strip_tags($rep->description ?: $rep->transcriptSuggestion)); ?>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="report-status-badge" data-status="<?php echo \htmlspecialchars($rep->status); ?>">
                                <?php echo $statusText; ?>
                            </span>
                        </td>
                        <td class="actions-cell">
                            <button type="button"
                                    class="button edit btn-view-report"
                                    data-payload='<?php echo $reportData; ?>'
                                    title="Report prüfen">
                                <i class="fa-solid fa-search"></i>
                            </button>
                        </td>
                    </tr>
                <?php } ?>
            <?php } ?>
        </tbody>
    </table>
</div>
<div id="report-pagination"
     class="pagination-wrapper"></div>
