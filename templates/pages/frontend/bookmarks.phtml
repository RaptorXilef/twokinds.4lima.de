<?php

declare(strict_types=1);

use App\Core\Entity\ComicPage;

/**
 * @var array            $settings
 * @var array<ComicPage> $comics
 */
$baseUrl = \rtrim($settings['base_url'] ?? '', '/');

// Wir bauen ein JS-Lexikon aus der Datenbank, um immer korrekte Pfade und Kapitel zu haben
$comicDictionary = [];
foreach ($comics as $c) {
    $dateObj                        = \DateTimeImmutable::createFromFormat('Ymd', \substr($c->id->value, 0, 8));
    $cb                             = $c->imageUpdatedAt ? '?c=' . $c->imageUpdatedAt : '';
    $comicDictionary[$c->id->value] = [
        'id'        => $c->id->value,
        'title'     => $c->name !== '' ? $c->name : 'Kein Titel',
        'type'      => $c->type,
        'chapter'   => $c->chapterId ?: 'Unbekannt',
        'date'      => $dateObj ? $dateObj->format('d.m.Y') : \substr($c->id->value, 0, 8),
        'thumb'     => $baseUrl . '/assets/images/comic/thumbnails/' . $c->id->value . '.webp' . $cb,
        'permalink' => $baseUrl . '/comic/' . $c->id->value,
    ];
}

// Wandle die Cloud-Bookmarks in ein JS-Array um (nur die IDs)
$cloudIds = [];
if ($isLoggedIn) {
    foreach ($cloudBookmarks as $bm) {
        $cloudIds[] = $bm->comicId;
    }
}

include __DIR__ . '/../../components/frontend/_public_header.phtml';
?>

