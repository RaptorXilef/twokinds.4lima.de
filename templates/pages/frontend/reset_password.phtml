<?php

declare(strict_types=1);

/**
 * @var array  $settings
 * @var string $pageTitle
 * @var bool   $isValidToken
 * @var string $token
 */
$baseUrl = \rtrim($settings['base_url'] ?? '', '/');
include __DIR__ . '/../../components/frontend/_public_header.phtml';
?>
<main class="content-area">
    <article style="width: 100%; max-width: 500px; margin: 0 auto; padding: 20px;">
        <header style="text-align: center; margin-bottom: 30px;">
            <h1 class="page-header"
                style="border: none; margin-bottom: 10px;"><?php echo \htmlspecialchars($pageTitle); ?></h1>
        </header>

        <div
             style="background: var(--content-box-bg); padding: 30px; border-radius: 8px; border: 1px solid var(--border-medium); box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <?php if (! $isValidToken) { ?>
                <div
                     style="padding: 20px; text-align: center; color: var(--status-red-text); background: var(--status-red-bg); border: 1px solid var(--status-red-border); border-radius: 4px;">
                    <i class="fa-solid fa-circle-xmark"
                       style="font-size: 2em; margin-bottom: 10px;"></i><br>
                    <strong>Dieser Link ist ungültig oder bereits abgelaufen.</strong><br><br>
                    <a href="<?php echo $baseUrl; ?>/passwort-vergessen" class="button">Neuen Link anfordern</a>
                </div>
            <?php } else { ?>
                <div id="reset-status-msg"
                     style="display: none; padding: 10px; border-radius: 4px; margin-bottom: 20px; font-weight: bold; text-align: center;">
                </div>

                <form id="frontend-reset-form"
                      class="admin-form">
                    <input type="hidden"
                           name="token"
                           value="<?php echo \htmlspecialchars($token); ?>">
                    <div class="form-group"
                         style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: bold; margin-bottom: 5px;">Neues Passwort (min. 8
                            Zeichen)</label>
                        <input type="password"
                               name="password"
                               required
                               minlength="8"
                               style="width: 100%; padding: 10px; border: 1px solid var(--border-medium); border-radius: 4px; background: var(--content-bg); color: var(--text-color);">
                    </div>
                    <button type="submit"
                            id="reset-submit-btn"
                            class="button edit"
                            style="width: 100%; padding: 12px; font-size: 1.1em; font-weight: bold;">Passwort
                        speichern</button>
                </form>
            <?php } ?>
        </div>
    </article>
</main>

<?php if ($isValidToken) { ?>
    <script nonce="<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>">
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('frontend-reset-form');
        const msg = document.getElementById('reset-status-msg');
        const btn = document.getElementById('reset-submit-btn');

        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Speichere...';

                const formData = new window.FormData(form); // wenn in JS-Datei window. entfernen
                formData.append('csrf_token', '<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? ''); ?>');

                try {
                    const res = await fetch('<?php echo $baseUrl; ?>/api/frontend_reset_password', {
                        method: 'POST',
                        body: formData
                    });
                    const json = await res.json();

                    msg.style.display = 'block';
                    if (json.success) {
                        msg.style.backgroundColor = 'var(--status-green-bg)';
                        msg.style.color = 'var(--status-green-text)';
                        msg.style.border = '1px solid var(--status-green-border)';
                        msg.innerHTML = '<i class="fa-solid fa-check"></i> ' + json.message;
                        setTimeout(() => window.location.href = '<?php echo $baseUrl; ?>/' + json.redirect, 1000);
                    } else {
                        msg.style.backgroundColor = 'var(--status-red-bg)';
                        msg.style.color = 'var(--status-red-text)';
                        msg.style.border = '1px solid var(--status-red-border)';
                        msg.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + json
                            .error;
                        btn.disabled = false;
                        btn.textContent = 'Passwort speichern';
                    }
                } catch (err) {
                    msg.style.display = 'block';
                    msg.style.backgroundColor = 'var(--status-red-bg)';
                    msg.style.color = 'var(--status-red-text)';
                    msg.innerHTML = 'Verbindungsfehler.';
                    btn.disabled = false;
                    btn.textContent = 'Passwort speichern';
                }
            });
        }
    });

    </script>
<?php } ?>
