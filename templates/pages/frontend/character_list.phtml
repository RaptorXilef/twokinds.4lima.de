<?php

declare(strict_types=1);

/**
 * @var array  $characters
 * @var array  $groups
 * @var string $pageTitle
 * @var array  $settings
 */
$baseUrl         = \rtrim($settings['base_url'], '/');
$placeholderPath = "{$baseUrl}/assets/images/layout/thumbnails/placeholder.jpg";

// Charaktere für schnellen Zugriff indizieren
$charMap = [];
foreach ($characters as $char) {
    $charMap[$char->id->value] = $char;
}

include __DIR__ . '/../../components/frontend/_public_header.phtml';
?>

<main class="content-area">
    <article style="width: 100%; max-width: 900px; margin: 0 auto;">
        <header>
            <h1 class="page-header">Charakter Übersicht</h1>
        </header>
        <p class="character-overview-intro">Eine alphabetische Übersicht aller Charaktere, eingeteilt in Gruppen.</p>

        <div class="comic-characters">
            <div class="character-list">
                <?php if (empty($groups)) { ?>
                    <p class="empty-table-message">Es wurden noch keine Charakter-Gruppen angelegt.</p>
                <?php } else { ?>
                    <?php foreach ($groups as $group) { ?>
                        <div class="character-group">
                            <h4><?php echo \htmlspecialchars($group->name); ?></h4>
                            <div class="character-group-list">
                                <?php
                                if (empty($group->characterIds)) { ?>
                                    <span style="color: var(--text-color-faded); font-style: italic;">Keine Charaktere in dieser Gruppe.</span>
                                    <?php } else {
                                        foreach ($group->characterIds as $charIdObj) {
                                            $charId = $charIdObj->value;
                                            if (! isset($charMap[$charId])) {
                                                continue;
                                            } // Referenzfehler abfangen

                                            $character = $charMap[$charId];
                                            $picUrl    = $character->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$character->picUrl}" : $placeholderPath;
                                            ?>
                                        <div class="character-item">
                                            <a href="<?php echo $baseUrl; ?>/charaktere/<?php echo \htmlspecialchars($character->name); ?>">
                                        <div class="character-avatar-container">
                                            <img src="<?php echo \htmlspecialchars($picUrl); ?>" alt="<?php echo \htmlspecialchars($character->name); ?>">
                                        </div>
                                        <p class="character-name"><?php echo \htmlspecialchars($character->name); ?></p>
                                    </a>
                                        </div>
                                <?php }
                                        } ?>
                            </div>
                        </div>
                    <?php } ?>
                <?php } ?>
            </div>
        </div>
    </article>
</main>

<?php include __DIR__ . '/../../components/frontend/_public_footer.phtml'; ?>
