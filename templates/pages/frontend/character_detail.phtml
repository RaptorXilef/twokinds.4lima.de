<?php

declare(strict_types=1);

use App\Core\Entity\Character;

/**
 * @var Character $character
 * @var array $characterComics
 * @var string $pageTitle
 * @var array $settings
 * @var string $appRoot
 */
$baseUrl = \rtrim($settings['base_url'], '/');
$placeholderPath = "{$baseUrl}/assets/images/system/placeholder.webp";

// Das kleine Profilbild für den Header
$profilePicUrl = $character->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$character->picUrl}" : $placeholderPath;

// Bestimme das Hauptbild für die große Ansicht links
if ($character->mainPic) {
    $picUrl = "{$baseUrl}/assets/images/characters/portraits/{$character->mainPic}";
} else {
    $picUrl = $profilePicUrl; // Fallback, falls kein großes Bild existiert
}
include __DIR__ . '/../../layouts/frontend/_public_header.phtml'; ?>
<main>
    <article class="max-w-900 w-100 center-block">
        <!-- Header mit kleinem Avatar -->
        <header class="d-flex align-center gap-20 mb-30 pb-15 border-bottom-2">
            <img src="<?php echo \htmlspecialchars($profilePicUrl); ?>"
                 alt="Avatar von <?php echo \htmlspecialchars($character->name); ?>"
                 class="avatar-lg"
                 style="<?php echo $character->isDead ? 'filter: grayscale(1); border: 2px solid #dc3545;' : ''; ?>">
            <h1 class="page-header border-none m-0 p-0 d-flex align-center flex-wrap gap-10">
                <?php echo \htmlspecialchars($character->name); ?>
                <?php if ($character->isDead) { ?>
                    <span class="badge bg-danger text-white font-small p-5" style="background: #dc3545; color: white;">Verstorben</span>
                <?php } ?>
            </h1>
        </header>
        <!-- HAUPT-LAYOUT: Display Block statt Flex, damit Float funktioniert! -->
        <section class="char-detail border-none p-0 mb-40 d-block">
            <!-- Linke Spalte: Profilbild & Swatch als Float -->
            <div class="char-img float-left w-175 mr-25 mb-15 text-center">
                <img class="portrait w-100 h-auto border-radius-8 border-medium mb-15"
                     style="box-shadow: 0 4px 8px rgba(0,0,0,0.1);"
                     src="<?php echo \htmlspecialchars($picUrl); ?>"
                     alt="<?php echo \htmlspecialchars($character->name); ?>">
                <?php if ($character->swatchPic) { ?>
                    <img src="<?php echo $baseUrl; ?>/assets/images/characters/palettes/<?php echo \htmlspecialchars($character->swatchPic); ?>"
                         alt="Color Swatch"
                         class="w-100 h-auto border-radius-4 border-medium mb-15"
                         loading="lazy">
                <?php } ?>
            </div>
            <!-- Rechte Spalte: Infos & Text umfließen das linke Bild -->
            <div class="char-info float-none w-auto d-block">
                <!-- Der volle Name als Untertitel, falls vorhanden -->
                <?php if ($character->fullName) { ?>
                    <h3 class="mt-0 mb-15 font-1-2x text-color">
                        <?php echo \htmlspecialchars($character->fullName); ?>
                    </h3>
                <?php } ?>
                <!-- Biografische Daten (Ohne Kasten, elegant als Liste) -->
                <?php if ($character->altNames || $character->gender || $character->age || $character->keidranAge || $character->rank || $character->species || $character->languages || $character->hairColor || $character->eyeColor || $character->furColor) { ?>
                    <ul class="list-none p-0 m-0"
                        style="line-height: 1.8;">
                        <?php if ($character->altNames) { ?>
                            <li><strong>Alternative Namen:</strong> <?php echo \htmlspecialchars($character->altNames); ?></li>
                        <?php } ?>
                        <?php if ($character->gender) { ?>
                            <li><strong>Geschlecht:</strong> <?php echo \htmlspecialchars($character->gender); ?></li>
                        <?php } ?>
                        <?php if ($character->age) { ?>
                            <li><strong>Alter:</strong> <?php echo \htmlspecialchars($character->age); ?> Jahre</li>
                        <?php } ?>
                        <?php if ($character->keidranAge) { ?>
                            <li><strong>Menschen-Äquivalent:</strong> ~<?php echo \htmlspecialchars($character->keidranAge); ?> Jahre</li>
                        <?php } ?>
                        <?php if ($character->rank) { ?>
                            <li><strong>Klasse/Rang:</strong> <?php echo \htmlspecialchars($character->rank); ?></li>
                        <?php } ?>
                        <?php if ($character->species || $character->subspecies) {
                            $sp = $character->species ?: '';
                            $sub = $character->subspecies ?: '';
                            $displaySpecies = \trim($sub . ' ' . $sp); ?>
                            <li><strong>Spezies:</strong> <?php echo \htmlspecialchars($displaySpecies); ?></li>
                        <?php } ?>
                        <?php if ($character->languages) { ?>
                            <li><strong>Sprachen:</strong> <?php echo \htmlspecialchars($character->languages); ?></li>
                        <?php } ?>
                        <?php if ($character->hairColor) { ?>
                            <li><strong>Haarfarbe:</strong> <?php echo \htmlspecialchars($character->hairColor); ?></li>
                        <?php } ?>
                        <?php if ($character->eyeColor) { ?>
                            <li><strong>Augenfarbe:</strong> <?php echo \htmlspecialchars($character->eyeColor); ?></li>
                        <?php } ?>
                        <?php if ($character->furColor) { ?>
                            <li><strong>Fellfarbe:</strong> <?php echo \htmlspecialchars($character->furColor); ?></li>
                        <?php } ?>
                    </ul>
                <?php } ?>
                <!-- Das HTML-Transkript / Die Biografie -->
                <!-- Unsichtbarer Speicher des Roh-HTMLs für das Melde-Modal -->
                <textarea id="raw-char-description" class="hidden" aria-hidden="true"><?php echo \htmlspecialchars($character->description ?? ''); ?></textarea>
                <div class="character-description my-20 font-lg"
                     style="line-height: 1.6;">
                    <?php if ($character->description !== null && \trim($character->description) !== '') {
                        echo $character->description;
                    } else {
                        echo '<p class="text-faded" style="font-style: italic;">Noch keine Biografie in der Datenbank hinterlegt.</p>';
                    } ?>
                </div>
            </div>

            <!-- Ref Sheets: Fließen elegant als Masonry-Grid (ohne Lücken) -->
            <?php if (!empty($character->refSheets)) { ?>
                <div class="masonry-grid-140">
                    <?php foreach ($character->refSheets as $sheet) { ?>
                        <a href="<?php echo $baseUrl; ?>/assets/images/characters/refsheets/<?php echo \htmlspecialchars($sheet); ?>" target="_blank" title="Reference Sheet (Vollbild)" class="masonry-item">
                        <img src="<?php echo $baseUrl; ?>/assets/images/characters/refsheets/<?php echo \htmlspecialchars($sheet); ?>" alt="Ref Sheet" loading="lazy">
                        </a>
                    <?php } ?>
                </div>
            <?php } ?>
            <!-- Clearfix, damit die Section den gesamten Inhalt umschließt -->
            <div class="clear"></div>
        </section>

        <!-- Comic-Auftritte -->
        <section>
            <h2 class="font-1-5x mb-15 pb-5 d-flex justify-between align-end border-bottom-light"> Alle Comic-Auftritte
                <span class="comic-count-badge badge-pill">
                <?php echo \count($characterComics); ?> Seiten </span>
            </h2>
            <?php if (empty($characterComics)) { ?>
                <div class="no-bookmarks bg-even border-radius-8 p-30 text-center">
                    <p class="m-0 text-light">Dieser Charakter hat bisher keine markierten Comic-Auftritte.</p>
                </div>
            <?php } else { ?>
                <div class="chapter-links tag-page-links">
                    <?php foreach ($characterComics as $comic) {
                        $comicId = $comic->id->value;
                        $cb = $comic->imageUpdatedAt ? '?c=' . $comic->imageUpdatedAt : '';
                        $thumbDisk = "{$appRoot}/public/assets/images/comics/thumbnails/{$comicId}.webp";
                        $thumbPath = \file_exists($thumbDisk)
                            ? "{$baseUrl}/assets/images/comics/thumbnails/{$comicId}.webp{$cb}"
                            : "{$baseUrl}/assets/images/system/in-translation.webp";
                        $dateObj = \DateTimeImmutable::createFromFormat('Ymd', \substr($comicId, 0, 8));
                        $displayDate = $dateObj ? $dateObj->format('d.m.Y') : $comicId;
                        $pageName = "Seite vom {$displayDate}" . ($comic->name !== '' ? ": {$comic->name}" : '');
                        $pageLink = "{$baseUrl}/comic/{$comicId}"; ?>
                        <a href="<?php echo $pageLink; ?>" title="<?php echo \htmlspecialchars($pageName); ?>" class="loaded">
                        <span><?php echo \htmlspecialchars($pageName); ?></span>
                        <img src="<?php echo \htmlspecialchars($thumbPath); ?>" alt="<?php echo \htmlspecialchars($pageName); ?>" loading="lazy">
                        </a>
                    <?php } ?>
                </div>
            <?php } ?>
        </section>
    </article>
</main>
<?php include __DIR__ . '/../../layouts/frontend/_public_footer.phtml'; ?>
