# =============================================================================
# PHPStan Konfiguration für High-End Code-Qualität
# =============================================================================

includes:
    # WICHTIG: Bleeding Edge muss unter 'includes' stehen, nicht bei bootstrapFiles.
    # Aktiviert die neuesten, striktesten Analysen (z.B. Dead Code Detection).
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan-baseline.neon
    # - vendor/phpstan/phpstan-phpunit/extension.neon # (macht jetzt der installer)
    # - vendor/phpstan/phpstan-strict-rules/rules.neon # (macht jetzt der installer)

parameters:
    # Level 0-9
    # Level 5 prüft Typen, erlaubt aber noch etwas Flexibilität.
    # Level 9 wäre "Maximaler Schmerz" (nur für neue Projekte empfohlen).
    # TODO: Vor release auf "max" setzen ohne "
    level: 0
    # Erstmal 0 um Architekturbrüche zu finden, danach wieder 6

    # Welche Ordner sollen analysiert werden?
    paths:
        - src
        - tests
        - public
        - config

    scanDirectories:
        - src
    bootstrapFiles:
        - vendor/autoload.php

    # Exklusionen (Vendor und Node_Modules sollten ignoriert werden)
    excludePaths:
        analyse:
            - vendor
            - node_modules
            - public/dist (?)
            - '**/.debug/**'

    # Wir simulieren eine PHP 8.4 Umgebung (80400), damit PHPStan
    # neue Features (wie Property Hooks) bereits jetzt versteht.
    phpVersion: 80400

    # Cache beschleunigt die Analyse massiv
    tmpDir: .cache/phpstan

    # Nutzt alle Kerne (Parallelisierung)
    parallel:
        processTimeout: 300.0

    # Prüft, ob Funktionen Seiteneffekte haben (Clean Code)
    rememberPossiblyImpureFunctionValues: true

    # Meldet, wenn du einen Fehler ignorierst, der gar nicht mehr existiert
    reportUnmatchedIgnoredErrors: true

    # Dies verhindert, dass PHPStan denkt, er wüsste es besser als die Laufzeit,
    # wenn es um native Funktionen geht, die false liefern können.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Pest nutzt interne Methoden für seine API, das ist beabsichtigt.
        -
            message: '#Call to method .* of internal class Pest\\.* from outside its root namespace Pest#'
            path: tests/*

    disallowedFunctionCalls:
        # 1. Dateisystem-Operationen (I/O)
        -
            function:
                - 'unlink'
                - 'mkdir'
                - 'rmdir'
                - 'rename'
                - 'copy'
                - 'move_uploaded_file'
                - 'file_put_contents'
            message: 'Verstoß gegen Clean Architecture: Dateisystem-Operationen (I/O) sind hier verboten. Lagere dies in das Infrastructure-Layer aus.'
            allowIn:
                - src/Infrastructure/*
                - src/Bootstrap/*
                - public/dev/*

        # 2. Netzwerk-Operationen (cURL)
        -
            function:
                - 'curl_init'
                - 'curl_exec'
                - 'curl_setopt'
                - 'curl_setopt_array'
                - 'curl_multi_init'
                - 'curl_multi_add_handle'
                - 'curl_multi_exec'
            message: 'Verstoß gegen Clean Architecture: Netzwerk-Operationen (cURL) sind hier verboten. Nutze einen API-Client im Infrastructure-Layer.'
            allowIn:
                - src/Infrastructure/*

        # 3. Bildverarbeitung (GD Library)
        -
            function:
                - 'imagecreatefromstring'
                - 'imagecreatefromjpeg'
                - 'imagecreatefrompng'
                - 'imagecreatefromwebp'
                - 'imagecreatetruecolor'
                - 'imagecopyresampled'
                - 'imagecrop'
                - 'imagewebp'
                - 'imagejpeg'
            message: 'Verstoß gegen Clean Architecture: Direkte Bildverarbeitung ist hier verboten. Nutze das MediaServiceInterface.'
            allowIn:
                - src/Infrastructure/Media/*

# 4. Verbot von direkten HTTP- und Session-Manipulationen
        -
            function:
                - 'header'
                - 'http_response_code'
                - 'setcookie'
                - 'session_start'
                - 'session_destroy'
                - 'session_regenerate_id'
                - 'session_write_close'
                - 'set_time_limit'
            message: 'Verstoß gegen Clean Architecture: Direkte HTTP- oder Session-Manipulation ist verboten. Nutze Response-Objekte oder den SessionManager.'
            allowIn:
                - */Application/Response/*
                - */Application/Session/SessionManager.php
                - */Application/Middleware/SecurityHeadersMiddleware.php
                - */Application/Exception/GlobalExceptionHandler.php
                - */Application/FrontendController.php
                - */Bootstrap/*
                - public/*

        # 5. Verbot von Debug- und Kill-Funktionen
        -
            function:
                - 'die'
                - 'exit'
                - 'var_dump'
                - 'print_r'
                - 'phpinfo'
            message: 'Verstoß gegen Clean Architecture: Nutze Exceptions für Abbrüche und Logger für Debugging.'
            allowIn:
                - public/dev/*
                - public/index.php
                - */Application/Response/*
                - */Application/Exception/GlobalExceptionHandler.php
                - */Application/FrontendController.php

        # 6. Verbot von System/Exec Funktionen (Sicherheitsrisiko)
        -
            function:
                - 'exec'
                - 'passthru'
                - 'shell_exec'
                - 'system'
                - 'eval'
            message: 'Sicherheitsrisiko: System- und Eval-Aufrufe sind streng verboten!'

        # 7. Verbot der nativen Mail-Funktion
        -
            function:
                - 'mail'
            message: 'Verstoß gegen Clean Architecture: Nutze das MailServiceInterface für E-Mails.'

        # 8. Verbot von nativem MySQLi (Wir nutzen ausschließlich PDO in der Infrastructure)
        -
            function:
                - 'mysqli_connect'
                - 'mysqli_query'
            message: 'Verstoß gegen Clean Architecture: Datenbank-Operationen laufen ausschließlich über PDO im Infrastructure-Layer.'


    disallowedSuperglobals:
        # Verbot ALLER Superglobals außerhalb der vorgesehenen Request/Session-Kapselung
        -
            superglobal:
                - '$_FILES'
                - '$_POST'
                - '$_GET'
                - '$_REQUEST'
                - '$_SESSION'
                - '$_COOKIE'
                - '$_SERVER'
                - '$_ENV'
            message: 'Direkter Zugriff auf Superglobals ist verboten. Nutze das injizierte ServerRequest-Objekt oder den SessionManager.'
            allowIn:
                - */Application/Http/ServerRequest.php
                - */Application/Session/SessionManager.php
                - */Application/Exception/GlobalExceptionHandler.php
                - */Application/Middleware/*
                - */Bootstrap/app.php
                - public/*
