<?php

declare(strict_types=1);

use App\Core\Entity\Character;
use App\Core\Entity\CharacterGroup;

/**
 * @var string           $baseUrl
 * @var Character[]      $characters
 * @var CharacterGroup[] $groups
 */
?>

<!-- ========================================== -->
<!-- SECTION: CHARAKTERE                        -->
<!-- ========================================== -->
<section id="section-characters"
         class="content-section">
    <div class="table-controls actions-bar">
        <div class="top-actions">
            <button type="button"
                    class="button add"
                    id="btn-add-char">
                <i class="fa-solid fa-plus"></i> Neuen Charakter erstellen
            </button>
        </div>
    </div>

    <div class="sitemap-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 100px;">ID</th>
                    <th style="width: 80px;">Avatar</th>
                    <th>Name & Beschreibung</th>
                    <th style="width: 120px; text-align: right;">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <?php if (empty($characters)) { ?>
                    <tr>
                        <td colspan="4"
                            class="empty-table-message">Keine Charaktere angelegt.</td>
                    </tr>
                <?php } else { ?>
                    <?php foreach ($characters as $char) {
                        $cId = $char->id->value;
                        $pic = $char->picUrl ? "{$baseUrl}/assets/images/characters/profiles/{$char->picUrl}" : 'https://placehold.co/100x100?text=N/A';

                        $charData = \json_encode([
                            'id'          => $cId,
                            'name'        => $char->name,
                            'picUrl'      => $char->picUrl ?? '',
                            'description' => $char->description ?? '',
                        ], \JSON_HEX_APOS | \JSON_HEX_QUOT);
                        ?>
                        <tr>
                            <td class="mono"><?php echo \htmlspecialchars($cId); ?></td>
                            <td>
                                <img src="<?php echo \htmlspecialchars($pic); ?>"
                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;">
                            </td>
                            <td>
                                <strong><?php echo \htmlspecialchars($char->name); ?></strong>
                                <?php if ($char->description) { ?>
                                    <div class="description-preview"
                                         style="max-height: 2.5em;"><?php echo \strip_tags($char->description); ?></div>
                                <?php } ?>
                            </td>
                            <td class="actions-cell">
                                <form>
                                    <button type="button"
                                            class="button edit btn-edit-char"
                                            data-payload='<?php echo $charData; ?>'
                                            title="Bearbeiten">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button type="button"
                                            class="button delete btn-delete-char"
                                            data-id="<?php echo \htmlspecialchars($cId); ?>"
                                            data-name="<?php echo \htmlspecialchars($char->name); ?>"
                                            title="Löschen">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <?php } ?>
                <?php } ?>
            </tbody>
        </table>
    </div>
</section>
