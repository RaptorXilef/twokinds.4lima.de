# ##############################################################################
# ##                                                                          ##
# ##      TWOKINDS .HTACCESS - FRONT-CONTROLLER & PERFORMANCE EDITION         ##
# ##                                                                          ##
# ##############################################################################

Options -Indexes -MultiViews +SymLinksIfOwnerMatch
DirectoryIndex index.php
AddDefaultCharset UTF-8
DefaultLanguage de-DE
ServerSignature Off

LimitRequestBody 10485760

# --- BLOCK 1: Security Hardening (Apache-Level) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F]
</IfModule>

<FilesMatch "(^\.htaccess|php\.ini|licence\.txt|readme\.html|composer\.|package\.|^\.env|\.sql$|\.log$|\.bak$)$">
    Require all denied
</FilesMatch>

# Schutz vor Skript-Ausführung in Asset-Ordnern
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^.*/(assets|data|cache|vendor|node_modules|\.git)/.*\.php$ [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- BLOCK 2: Bot-Firewall ---
<IfModule mod_setenvif.c>
    SetEnvIfNoCase User-Agent (GPTBot|CCBot|ChatGPT-User|PerplexityBot|Amazonbot|ClaudeBot|Omigili|ImagesiftBot|CriteoBot|Pinterestbot|AhrefsBot|SemrushBot|DotBot|Bytespider) bad_bot
    <RequireAll>
        Require all granted
        Require not env bad_bot
    </RequireAll>
</IfModule>

# --- BLOCK 3: MIME & Komprimierung (Brotli / GZIP) ---
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType application/javascript .mjs
    AddType "application/json; charset=utf-8" .json
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/ld+json application/xml font/woff font/woff2 image/svg+xml application/manifest+json
</IfModule>

# Pre-Compressed Assets ausliefern
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.*)$ $1.br [L]

    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.*)$ $1.gz [L]
</IfModule>

<FilesMatch "\.(js\.br|css\.br|mjs\.br)$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
</FilesMatch>

# --- BLOCK 4: Caching für statische Assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ttf|woff|woff2|ico)$">
        Header set Cache-Control "max-age=31536000, public, no-transform, immutable"
        Header set Timing-Allow-Origin "*"
    </FilesMatch>

    <FilesMatch "\.(css|js|mjs|json)$">
        Header set Cache-Control "max-age=2592000, public, no-transform"
    </FilesMatch>

    # PHP-Header für HTML werden von SecurityHeadersMiddleware gesetzt!
</IfModule>

# --- BLOCK 5: URL-Hygiene, SEO & Front-Controller Routing ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 5.1: HTTPS & WWW-Zwang (SEO Canonical)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    # Ausgenommen localhost/local dev
    RewriteCond %{HTTP_HOST} !\.local$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # ========================================================
    # 5.2: GOOGLE SEARCH CONSOLE - SEO REDIRECTS (301)
    # ========================================================

    # Entfernt explizite /index.php Aufrufe aus der URL (Duplicate Content Schutz)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Trailing Slashes von Ordnern entfernen (z.B. /charaktere/ -> /charaktere)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # Alte Charakter-URLs
    RewriteRule ^charakter-vorstellung(\.php)?$ /charaktere [R=301,L]

    # Alte "Über den Comic" Seite (Leitet auf Startseite um)
    RewriteRule ^ueber_den_comic(\.php)?$ / [R=301,L]

    # Alte Comics im Root-Verzeichnis (z.B. /20231021.php -> /comic/20231021)
    RewriteRule ^(\d{8})\.php$ /comic/$1 [R=301,L]

    # Alte Comics im Comic-Ordner (z.B. /comic/20200513.php -> /comic/20200513)
    RewriteRule ^comic/(\d{8})\.php$ /comic/$1 [R=301,L]

    # ========================================================

    # 5.3: Globale .php Entfernung (SEO: 301 Redirect für den Rest)
    # Fängt alles ab, was noch eine .php Endung hat, aber keine API ist
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 5.4: Hotlink-Schutz für Comics (Bandbreiten-Schutz)
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?twokinds\.4lima\.(de|local) [NC]
    RewriteCond %{REQUEST_URI} ^/assets/images/comic/ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|avif)$ - [NC,F,L]

    # 5.5: THE FRONT CONTROLLER (Das Herzstück der Architektur)
    # Wenn die Datei physisch existiert (Bilder, CSS, JS), direkt ausliefern (Fast-Exit)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Alles andere geht transparent an die index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
